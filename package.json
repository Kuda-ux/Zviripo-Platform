{
  "name": "comodities",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "test": "turbo test",
    "typecheck": "turbo typecheck",
    "format:check": "prettier --check .",
    "db:push": "supabase db push",
    "db:test": "supabase test db",
    "db:types": "supabase gen types typescript --linked --schema public > packages/database/src/database.types.ts",
    "db:status": "node scripts/verify-supabase.mjs"
  },
  "devDependencies": {
    "@types/node": "22.15.3",
    "prettier": "3.5.3",
    "turbo": "2.5.2",
    "typescript": "5.8.3"
  }
}
